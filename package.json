{
  "name": "smart-proxy",
  "version": "1.0.0",
  "type": "module",
  "description": "Smart Proxy Chrome Extension (Manifest V3)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/gen-icons.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@preact/preset-vite": "^2.10.1",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "proxy-chain": "^2.5.6",
    "sharp": "^0.33.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
